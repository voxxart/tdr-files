local State=require('../Tower Defense R/ServerScriptService/Simulation/WaveState')
local state=State.new()
local players={[1]=true,[2]=true,[3]=true}
state:Begin(1,0,90,30,false)
assert(not state.Open and not state:Vote(1,1,players))
state:Update(60); assert(state.Open)
assert(state:Vote(1,1,players) and not state.Skipped)
assert(not state:Vote(1,1,players) and not state:Vote(99,1,players) and not state:Vote(2,0,players))
assert(state:Vote(2,1,players) and state.Skipped and not state.Open)
assert(state:CanAdvance(true,500),'a skip must advance while enemies remain and spawning is still active')
assert(not state:Vote(3,1,players),'a passed vote cannot be reused')
state:Close(); assert(not state:CanAdvance(false,0))
state:Begin(2,70,90,90,false)
assert(state:Count(players)==0 and state.Open and not state:CanAdvance(true,0),'empty map during a spawn gap must not finish a wave')
assert(state:Vote(1,2,players)); players[3]=nil; state:Recheck(players); assert(state.Skipped,'membership changes must recalculate quorum')
state:Begin(3,100,5,90,true); state:Update(120)
assert(not state.Open and not state:Vote(1,3,players))
assert(not state:CanAdvance(true,0) and not state:CanAdvance(false,1) and state:CanAdvance(false,0),'final wave waits for all spawns and all enemies, regardless of timer')
state:Begin(4,130,5,5,false); state:Update(135); assert(state:CanAdvance(true,100),'ordinary timeout overlaps queued spawns too')
print('Wave state passed: opening threshold, deduplication, stale/outsider votes, skip during spawning, reset, roster changes, spawn-gap safety, timeout and final-wave safety')
