local State=require('../Tower Defense R/ServerScriptService/TimescaleSystem/VoteState')
local solo={[1]=true};local group={[1]=true,[2]=true,[3]=true}
local s=State.new()
local ok,err,value=s:Request(0,1,solo)
assert(ok and value==1.5 and not s.Active and s.CooldownUntil==15)
assert(not s:Request(14.99,1.5,solo))
ok,err,value=s:Request(15,1.5,solo);assert(ok and value==1 and s.CooldownUntil==30)
s=State.new();assert(s:Request(0,1,group))
assert(s.Active and s.Target==1.5 and s.CooldownUntil==0)
local id=s.Id
assert(not s:Vote(1,99,id,true,group,1))
assert(not s:Vote(1,1,id-1,true,group,1))
assert(s:Vote(1,1,id,true,group,1))
assert(not s:Vote(1,1,id,true,group,1))
assert(s:Vote(2,2,id,true,group,1) and s.Active)
ok,value=s:Vote(3,3,id,true,group,1)
assert(ok and value==1.5 and not s.Active and s.CooldownUntil==63)
assert(not s:Request(62.9,1.5,group))
assert(s:Request(63,1.5,group) and s.Target==1)
id=s.Id
assert(s:Vote(64,2,id,false,group,1.5))
assert(s.Active and s.Failed and s.CooldownUntil==124)
assert(s:Vote(65,1,id,true,group,1.5))
assert(s:Vote(66,3,id,true,group,1.5))
assert(s.Active and s:Step(77.99,group,1.5)==nil)
s:Step(78,group,1.5)
assert(not s.Active and s.CooldownUntil==124,'veto cooldown must not restart at expiry')
s=State.new();s:Request(10,1,group);s:Step(25,group,1)
assert(not s.Active and s.Failed and s.CooldownUntil==85,'timeout starts cooldown at deadline')
s=State.new();s:Request(0,1,{[1]=true,[2]=true})
s:Vote(1,1,s.Id,true,group,1);s:Vote(2,2,s.Id,true,group,1)
assert(s.Active,'new players must also approve')
assert(s:Step(3,{[1]=true,[2]=true},1)==1.5,'leavers must not block all remaining players')
s=State.new();s:Request(0,1,group);s:Cancel();assert(not s.Active)
print('Timescale voting: solo cooldown, unanimity, veto persistence, timeout, cooldown timing, stale/duplicate votes, roster changes and cancellation passed')
