local Clock = require('../Tower Defense R/ServerScriptService/Simulation/MatchClock')
local c = Clock.new()
local first = c:Begin()
local fired = 0
c:After(first, 3, function() fired += 1 end)
c:Advance(1, 1)
c:Advance(10, 0)
assert(c.Time == 1 and fired == 0, 'Pause must freeze deadlines')
c:Advance(1, 2)
assert(c.Time == 3 and fired == 1, 'Speed changes must affect existing deadlines')
local cancel = c:After(first, 0, function() fired += 10 end)
cancel()
c:Advance(0, 1)
assert(fired == 1)
c:After(first, 0, function() c:Stop() end)
c:After(first, 0, function() fired += 100 end)
c:Advance(0, 1)
assert(fired == 1 and not c:IsCurrent(first), 'Stop must invalidate other due callbacks')
local second = c:Begin()
assert(second ~= first and c.Time == 0)
assert(c:After(first, 0, function() fired += 100 end) == nil)
c:After(second, 5, function() fired += 100 end)
c:Stop()
assert(#c._jobs == 0, 'Stop must release pending callbacks')
c:Begin()
c:Advance(100, 1)
assert(fired == 1, 'Old work must not execute after restart')
print('Match clock checks passed: pause, speed changes, cancellation, stop, restart')
